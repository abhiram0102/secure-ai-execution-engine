# Bubble-Wrap Sandbox — System Configuration
# Copy to .env and fill in real values.
#
# Rule:
#   WHAT the sandbox can access  →  per-task policy JSON (filesystem/database/network)
#   HOW the sandbox operates     →  this file (security, limits, credentials)
#
# Nothing in this file should ever appear in a per-task policy.
# Nothing security-critical should ever appear only in a per-task policy.

# ── Concurrency ───────────────────────────────────────────────────────────────
SANDBOX_MAX_SLOTS=25
SANDBOX_MAX_WAIT_SEC=15

# ── Per-job resource limits ───────────────────────────────────────────────────
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_FSIZE_MB=10
SANDBOX_MAX_CPU_TIME=10

# ── Sandbox security behaviour ────────────────────────────────────────────────
# Hide all bwrap flags from /proc/PID/cmdline.
# Disable only if debugging bwrap command construction.
SANDBOX_ARGFD_TRANSPORT=1

# ── Filesystem operator boundary ─────────────────────────────────────────────
# Host paths that any per-task policy is allowed to expose.
# A policy host_path outside these is rejected at load time.
SANDBOX_OPERATOR_BASE_PATHS=./host_data,/tmp,/data,/mnt,/var/log,/opt,/srv,/etc/ssl/certs

# ── Database upstream TLS requirement ────────────────────────────────────────
# When 1, every DB connection used by any task must have SSL_MODE=verify-full
# and a CA certificate path set.  Per-task policy cannot override this.
SANDBOX_REQUIRE_UPSTREAM_TLS=0

# ── Database connection: primary (postgres) ───────────────────────────────────
# Named connections are referenced from per-task policy via "connection": "primary".
# Credentials and host details never appear in policy — only here.
DB_PRIMARY_DRIVER=postgres
DB_PRIMARY_HOST=postgres.internal.network
DB_PRIMARY_PORT=5432
DB_PRIMARY_NAME=enterprise_db
DB_PRIMARY_USER=ai_sandbox_user
DB_PRIMARY_PASS_ENV=BWRAP_DB_PASS
DB_PRIMARY_SANDBOX_MOUNT=/tmp/pg
DB_PRIMARY_SSL_MODE=verify-full
DB_PRIMARY_SSL_CA=/etc/sandbox/certs/ca.crt
DB_PRIMARY_SSL_CERT=/etc/sandbox/certs/dbproxy-client.crt
DB_PRIMARY_SSL_KEY=/etc/sandbox/certs/dbproxy-client.key

# ── Database connection: warehouse (mysql) ────────────────────────────────────
DB_WAREHOUSE_DRIVER=mysql
DB_WAREHOUSE_HOST=mysql.internal.network
DB_WAREHOUSE_PORT=3306
DB_WAREHOUSE_NAME=warehouse_db
DB_WAREHOUSE_USER=ai_sandbox_user
DB_WAREHOUSE_PASS_ENV=BWRAP_MYSQL_PASS
DB_WAREHOUSE_SANDBOX_MOUNT=/tmp/mysql
DB_WAREHOUSE_SSL_MODE=verify-full
DB_WAREHOUSE_SSL_CA=/etc/sandbox/certs/ca.crt
DB_WAREHOUSE_SSL_CERT=/etc/sandbox/certs/dbproxy-client.crt
DB_WAREHOUSE_SSL_KEY=/etc/sandbox/certs/dbproxy-client.key

# ── DB credentials ────────────────────────────────────────────────────────────
# Never put real credentials here in version control.
# Inject at deployment time (Docker secrets, vault, CI secret injection).
BWRAP_DB_PASS=
BWRAP_MYSQL_PASS=
